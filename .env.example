# REQUIRED: secret API token (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=change-me-generate-a-long-random-token

# Server
HOST=127.0.0.1
PORT=5000

# Browser
HEADLESS=true
# Optional proxy, e.g. http://host:port
PROXY_URL=

# Limits / safety checks
RATE_LIMIT=5 per minute
MAX_CONCURRENT=1
MAX_PAGES_PER_REQUEST=25
MAX_PAGE_NUMBER=200
MAX_KEYWORD_LENGTH=200

# Timing (seconds / ms)
MIN_DELAY=4
MAX_DELAY=9
NAV_TIMEOUT_MS=20000
MAX_REQUEST_SECONDS=240
